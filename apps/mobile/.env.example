# Copiar a .env — NUNCA commitear .env
# En un celular físico usá la IP de tu PC, no localhost (ej. http://192.168.0.10:3000/api/v1)
EXPO_PUBLIC_API_URL="http://localhost:3000/api/v1"

# OAuth 2.0 Google — Client ID de tipo "Aplicación web" (también sirve en Expo Go)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
# Opcionales, para builds nativos
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""
